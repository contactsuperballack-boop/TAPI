# --- Server ---
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (system of record) ---
DATABASE_URL=postgres://tapi:tapi@localhost:5432/tapi

# --- LetsFG supplier credentials (server-side only; never expose to clients) ---
# Use Developer API auth. The same API key works for sandbox and production.
# Sandbox does not require a key, but if supplied it must be current/valid.
LETSFG_AUTH_MODE=developer
LETSFG_ENVIRONMENT=sandbox       # sandbox | production; production is opt-in only
LETSFG_API_KEY=                  # your existing LetsFG key; do not commit .env
LETSFG_BASE_URL=https://letsfg.co
LETSFG_SANDBOX_SPEED=fast        # fast | realistic (sandbox bookings only)
LETSFG_REQUEST_TIMEOUT_MS=20000
LETSFG_CIRCUIT_FAILURE_THRESHOLD=5
LETSFG_CIRCUIT_COOLDOWN_MS=30000

# --- Internal API auth (agency/API-client tokens, T-020) ---
TAPI_TOKEN_SECRET=change-me-before-prod

# --- Payments (Sprint 4) ---
# MockPaymentProvider only — no real provider (Paystack/Flutterwave/Stripe)
# has been chosen yet; that's an open Decision Gate item. See
# src/services/paymentProvider.interface.js.
MOCK_PAYMENT_WEBHOOK_SECRET=dev-only-insecure-secret

# --- Order pricing (T-071) ---
# Commercial model is an open Decision Gate item — these default to 0
# (cost-through pricing) so nothing charges a markup nobody agreed to.
ORDER_MARKUP_PERCENT=0
ORDER_SERVICE_FEE_FLAT=0

# --- Nigerian domestic supplier (Sprint 3 — scaffold only, do not enable in any real environment) ---
DOMESTIC_SUPPLIER_ENABLED=false

# --- Operational ---
REQUEST_TIMEOUT_MS=30000
# NEVER set this to true in production — test/CI environments only. See
# GO_LIVE_CHECKLIST.md and README (rate-limiter test-determinism fix).
DISABLE_RATE_LIMIT=false

# Number of reverse-proxy hops to trust for req.ip (default 1; 0 if the app is exposed directly)
TRUST_PROXY=1
APPROVAL_RETRY_WINDOW_MINUTES=15

# --- Security (audit response, Nov 2026) ---
# REQUIRED in production (the app refuses to start without them). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Passport numbers are encrypted with these keys. Format: id:base64key[,olderid:base64key]. The first is used for new data.
# Rotation: add a new key in front, restart, run `npm run passports:encrypt -- --rotate`, then retire the old key.
FIELD_ENCRYPTION_KEYS=
# FIELD_ENCRYPTION_KEY_ID=      # optional: choose which listed key is current
# Server-only credential for TAPI calling its own API (32+ random characters).
INTERNAL_SERVICE_TOKEN=
# How long an agent-assisted booking's approval stays valid (hours, default 48).
# AGENT_APPROVAL_TTL_HOURS=48

# --- Email (Postmark) ---
# MAIL_TRANSPORT=postmark
# POSTMARK_SERVER_TOKEN=
# MAIL_FROM="TAPI <no-reply@yourdomain.com>"
# PUBLIC_APP_URL=https://app.yourdomain.com

# --- Sprint 10.0: supplier-agnostic flights + booking poller ---
FLIGHT_SUPPLIER_CODE=letsfg      # supplier new flight searches use: letsfg | tiqwa | ng_domestic
TIQWA_ENABLED=false              # Tiqwa adapter is a SCAFFOLD: every method throws until verified and contracted
TIQWA_BASE_URL=                  # unverified; do not set until Tiqwa sandbox access is confirmed
BOOKING_POLL_INTERVAL_MS=15000   # npm run poll:bookings (use --once from cron instead of looping)
BOOKING_POLL_BATCH=50
BOOKING_MAX_POLL_ATTEMPTS=40     # then escalate to reconciliation_required

# --- Sprint 10.4: crash-window recovery + outbox ---
SUBMISSION_ORPHAN_AFTER_MINUTES=3   # a pending booking with no supplier id older than this is treated as interrupted
OUTBOX_INTERVAL_MS=5000             # npm run outbox:dispatch
OUTBOX_MAX_ATTEMPTS=8               # then the event is dead-lettered for a human

# --- Sprint 10.6: money ---
FX_BUFFER_BPS=100                # protective buffer on FX quotes (100 = 1%), max 1000
FX_STATIC_RATES=                 # DEV/SANDBOX ONLY, e.g. "USD:NGN=1500.25;GBP:NGN=1900". Refused in production.
SETTLE_INTERVAL_MS=60000         # npm run settle:sweep
