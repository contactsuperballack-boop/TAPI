# --- Server ---
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (system of record) ---
DATABASE_URL=postgres://tapi:tapi@localhost:5432/tapi

# --- LetsFG supplier credentials (server-side only, never exposed to clients) ---
# Flights: pick ONE auth path and set the matching vars. Do not straddle both (see T-040).
LETSFG_AUTH_MODE=pfs            # "pfs" (free bearer token, no unlock step) or "developer" (paid, unlock() required)
LETSFG_BEARER_TOKEN=            # required if LETSFG_AUTH_MODE=pfs
LETSFG_API_KEY=                 # REQUIRED for hotels regardless of LETSFG_AUTH_MODE above — LetsFG's public
                                 # docs show no free/PFS path for hotels (see letsfgHotelAdapter.js). Also
                                 # required if LETSFG_AUTH_MODE=developer for flights.
LETSFG_BASE_URL=https://letsfg.co
LETSFG_REQUEST_TIMEOUT_MS=20000 # Sprint 2: AbortController-enforced per-request timeout; keep below REQUEST_TIMEOUT_MS
LETSFG_CIRCUIT_FAILURE_THRESHOLD=5 # consecutive failures before the breaker opens (see domain/circuitBreaker.js)
LETSFG_CIRCUIT_COOLDOWN_MS=30000   # how long the breaker stays open before allowing a trial request

# --- Internal API auth (agency/API-client tokens, T-020) ---
TAPI_TOKEN_SECRET=change-me-before-prod

# --- Payments (Sprint 4) ---
# MockPaymentProvider only — no real provider (Paystack/Flutterwave/Stripe)
# has been chosen yet; that's an open Decision Gate item. See
# src/services/paymentProvider.interface.js.
MOCK_PAYMENT_WEBHOOK_SECRET=dev-only-insecure-secret

# --- Order pricing (T-071) ---
# Commercial model is an open Decision Gate item — these default to 0
# (cost-through pricing) so nothing charges a markup nobody agreed to.
ORDER_MARKUP_PERCENT=0
ORDER_SERVICE_FEE_FLAT=0

# --- Nigerian domestic supplier (Sprint 3 — scaffold only, do not enable in any real environment) ---
DOMESTIC_SUPPLIER_ENABLED=false

# --- Operational ---
REQUEST_TIMEOUT_MS=30000
# NEVER set this to true in production — test/CI environments only. See
# GO_LIVE_CHECKLIST.md and README (rate-limiter test-determinism fix).
DISABLE_RATE_LIMIT=false
