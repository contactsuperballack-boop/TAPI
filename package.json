{
  "name": "tapi-mvp",
  "version": "0.1.0",
  "description": "TAPI \u2014 Travel API Platform. Sprint 0/1 vertical slice: agency auth -> location resolution -> flight search -> offer -> validate -> book -> persist -> retrieve, via the LetsFG supplier adapter.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "cli": "node src/cli/index.js",
    "mcp": "node src/mcp/server.js",
    "reconcile": "node src/scripts/reconcile.js",
    "test": "jest --runInBand",
    "test:unit": "node --test \"tests/unit/**/*.test.js\""
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/unit/"
    ]
  }
}
